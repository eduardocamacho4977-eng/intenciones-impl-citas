<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTituloEjercicio10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 10: Seleccionar un Contacto"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/btnSeleccionarContactoAgenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar Contacto de la Agenda"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultado:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvContactoResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ningún contacto seleccionado."
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:padding="16dp"
        android:background="#F0F0F0"
        android:gravity="center" />

</LinearLayout>
