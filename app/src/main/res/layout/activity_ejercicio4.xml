<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloEjercicio4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 4: Agregar Elementos a Lista"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/etNuevoElemento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe un nuevo elemento"
            android:inputType="textPersonName" />

        <Button
            android:id="@+id/btnAgregarElemento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvElementosDinamicos"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
