<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTituloDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detalle del Lugar"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="24dp" />

    <ImageView
        android:id="@+id/imgDetalleLugar"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="Imagen del lugar en detalle"
        android:scaleType="centerInside"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvNombreDetalleLugar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvDescripcionDetalleLugar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>
